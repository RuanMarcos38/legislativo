# Defina no ambiente do processo. Este arquivo não é carregado automaticamente.
APP_NAME=Observatório Legislativo Brasil
PORT=8080
BIND_HOST=127.0.0.1
DATABASE_PATH=data/observatorio.db

# Atualização automática de todas as páginas das consultas suportadas.
AUTO_SYNC_ENABLED=1
AUTO_CAMARA_START_YEAR=1934
AUTO_SENADO_START_YEAR=1826
AUTO_VOTES_START_YEAR=2023
AUTO_REQUEST_INTERVAL=1
